rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ridham.gupta.programming@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- PHASE 4: Entity Validators ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.keys().size() <= 15 && // Allow some optional fields like gamerTag, rank etc
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['user', 'admin', 'moderator'] &&
             data.createdAt == request.time;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'description', 'startDate', 'endDate']) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.startDate is number &&
             data.endDate is number;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['eventId', 'userId', 'userEmail', 'status', 'registeredAt']) &&
             data.eventId is string && isValidId(data.eventId) &&
             data.userId == request.auth.uid &&
             data.userEmail is string &&
             data.status == 'registered' &&
             data.registeredAt == request.time;
    }

    // --- Match Blocks ---

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'gamerTag', 'rank', 'kdRatio', 'matchesPlayed']) &&
        incoming().role == existing().role &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt
      ) || isAdmin();
    }

    // Events
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registrations
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(registrationId) && isValidRegistration(incoming()) && 
                    exists(/databases/$(database)/documents/events/$(incoming().eventId));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Core Team
    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tournaments, Teams, Matches
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(teamId) && incoming().captainId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && existing().captainId == request.auth.uid && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['teamName', 'logoUrl', 'members']));
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stats
    match /stats/{statsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins helper collection
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
