{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public and private user information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "gamerTag": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "moderator"] },
        "status": { "type": "string", "enum": ["active", "banned"] },
        "rank": { "type": "string" },
        "kdRatio": { "type": "number" },
        "matchesPlayed": { "type": "number" },
        "attendanceStatus": { "type": "string", "enum": ["pending", "verified"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Details of an event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "venue": { "type": "string" },
        "speakers": { "type": "array", "items": { "type": "string" } },
        "capacity": { "type": "number" },
        "registeredCount": { "type": "number" },
        "imageUrl": { "type": "string" },
        "startDate": { "type": "number" },
        "endDate": { "type": "number" }
      }
    },
    "Registration": {
      "title": "Registration",
      "description": "User registration for an event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["registered", "attended"] },
        "registeredAt": { "type": "number" },
        "attendedAt": { "type": "number" }
      }
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Information about the project team",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "imageUrl": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "githubUrl": { "type": "string" }
      },
      "required": ["name", "role"]
    },
    "Stats": {
      "title": "Application Stats",
      "description": "Aggregated platform metrics",
      "type": "object",
      "properties": {
        "totalEvents": { "type": "number" },
        "liveEvents": { "type": "number" },
        "completedEvents": { "type": "number" },
        "totalUsers": { "type": "number" }
      }
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Esports tournament details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameName": { "type": "string" },
        "prizePool": { "type": "string" },
        "startDate": { "type": "number" },
        "registeredTeamsCount": { "type": "number" },
        "bannerImage": { "type": "string" },
        "teamSize": { "type": "number" },
        "entryFee": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "live", "completed"] }
      }
    },
    "Team": {
      "title": "Team",
      "description": "Esports team registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamName": { "type": "string" },
        "captainId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "logoUrl": { "type": "string" },
        "tournamentId": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "Match": {
      "title": "Match",
      "description": "Tournament match details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tournamentId": { "type": "string" },
        "teamA": { "type": "object" },
        "teamB": { "type": "object" },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "winnerId": { "type": "string" },
        "matchStatus": { "type": "string", "enum": ["upcoming", "live", "completed"] },
        "scheduledAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "events/{eventId}": {
      "schema": "Event",
      "description": "Event tracking"
    },
    "registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Event registrations"
    },
    "team/{memberId}": {
      "schema": "TeamMember",
      "description": "Project team members"
    },
    "stats/{statsId}": {
      "schema": "Stats",
      "description": "System-wide metrics"
    },
    "tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Esports tournaments"
    },
    "teams/{teamId}": {
      "schema": "Team",
      "description": "Tournament teams"
    },
    "matches/{matchId}": {
      "schema": "Match",
      "description": "Tournament matches"
    }
  }
}
