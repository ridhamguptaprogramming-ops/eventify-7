rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'ridham.gupta.programming@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
      ) || isAdmin();
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['user', 'admin'] &&
             data.createdAt is number;
    }

    // Event Rules
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && isValidEvent(request.resource.data);
      allow update: if isAdmin() && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.date is string && data.date.size() <= 100 &&
             data.venue is string && data.venue.size() <= 200 &&
             data.capacity is number && data.capacity > 0 &&
             data.registeredCount is number && data.registeredCount >= 0 &&
             (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             data.startDate is number &&
             data.endDate is number;
    }

    // Registration Rules
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && isValidRegistration(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() && isValidRegistration(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidRegistration(data) {
      return data.eventId is string && data.eventId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 256 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.status in ['registered', 'attended'] &&
             data.registeredAt is number;
    }

    // Stats Rules
    match /stats/{statsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin List
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }

    // Team Rules
    match /team/{memberId} {
      allow read: if true;
      allow create: if isAdmin() && isValidTeamMember(request.resource.data);
      allow update: if isAdmin() && isValidTeamMember(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidTeamMember(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             (!('linkedinUrl' in data) || (data.linkedinUrl is string && data.linkedinUrl.size() <= 1000)) &&
             (!('githubUrl' in data) || (data.githubUrl is string && data.githubUrl.size() <= 1000));
    }
  }
}
